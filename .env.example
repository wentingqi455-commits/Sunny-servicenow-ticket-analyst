# Copy this file to .env and fill it in. .env is ignored by git, never commit it.

# --- ServiceNow -------------------------------------------------------------
SN_INSTANCE_URL=https://yourcompany.service-now.com
SN_CLIENT_ID=
SN_CLIENT_SECRET=
# "password" (client + service account user) or "client_credentials"
SN_GRANT_TYPE=password
SN_USERNAME=
SN_PASSWORD=
# Ticket tables to export
SN_TABLES=incident,sc_req_item,problem,change_request
SN_DAYS=7

# --- Hardware barcodes ------------------------------------------------------
# Tickets whose category or subcategory matches one of these are treated as hardware
HARDWARE_CATEGORIES=hardware
# ServiceNow fields that hold the barcode (dot-walk allowed). Digits in the
# ticket text are also picked up.
BARCODE_FIELDS=cmdb_ci.asset_tag,cmdb_ci.serial_number
# Barcode lengths in digits (comma separated)
BARCODE_LENGTHS=8,14

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional, e.g. for a company proxy
OPENAI_BASE_URL=

OUTPUT_DIR=output
